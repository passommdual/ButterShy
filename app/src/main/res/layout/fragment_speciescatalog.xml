<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/species_catalog_main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/book_pages"
    tools:context=".ui.speciescatalog.SpeciesCatalogFragment">

    <!-- Filter Spinner

    Butterfly Grid -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/species_filter_layout_1"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@color/logo_green">

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/species_filter_layout_2"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@color/logo_green">

        <AutoCompleteTextView
            android:id="@+id/speciesFilterDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Filter by Species"
            android:inputType="none"
            android:text="All Species" />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/butterflyRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="175dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="4dp" />

</LinearLayout>
