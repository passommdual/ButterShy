<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/species_catalog_main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/book_pages"
    tools:context=".ui.speciescatalog.SpeciesCatalogFragment">

    <!-- Spacer to push filters lower on screen -->
    <View
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:visibility="invisible" />

    <!-- Combined Row: Search + Dropdown -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:weightSum="2">

        <!-- Text Search Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/search_filter_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Search by name"
            android:background="@color/logo_green"
            app:hintTextColor="@color/logo_dark_green"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:startIconTint="@color/logo_dark_green"
            app:endIconMode="clear_text"
            app:endIconTint="@color/logo_dark_green">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchFilterInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="10sp"
                android:textColor="@color/logo_dark_green" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Dropdown List Filter -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/species_filter_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:hint="Filter by Species"
            android:background="@color/logo_green"
            app:hintTextColor="@color/logo_dark_green"
            app:endIconTint="@color/logo_dark_green">

            <AutoCompleteTextView
                android:id="@+id/speciesFilterDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:text="All Species"
                android:textSize="10sp"
                android:textColor="@color/logo_dark_green" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- Filter Chips -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/filterChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:chipSpacingHorizontal="8dp"
        app:singleSelection="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/favoritesChip"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="Favorites Only" />

        <com.google.android.material.chip.Chip
            android:id="@+id/clearFilterChip"
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="false"
            android:text="Clear All" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Butterfly Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/butterflyRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="4dp" />

</LinearLayout>
