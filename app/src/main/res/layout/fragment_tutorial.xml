<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tutorial_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/book_pages"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/tutorial_main_layout"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <!-- Überschrift -->
        <TextView
            android:id="@+id/textTutorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <!-- Play/Resume Button - Visible at start and when paused -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/playResumeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Read Aloud"
                style="@style/Widget.MaterialComponents.Button"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textSize="14sp"
                android:minHeight="40dp"
                app:cornerRadius="20dp"
                android:backgroundTint="@color/logo_dark_green"
                android:textColor="@color/white"
                app:icon="@android:drawable/ic_media_play"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                android:layout_marginEnd="8dp"
                android:visibility="visible" />

            <!-- Pause Button - Only visible when playing -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pauseButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pause"
                style="@style/Widget.MaterialComponents.Button"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textSize="14sp"
                android:minHeight="40dp"
                app:cornerRadius="20dp"
                android:backgroundTint="@color/logo_dark_green"
                android:textColor="@color/white"
                app:icon="@android:drawable/ic_media_pause"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

            <!-- Read from Top Button - Only visible when paused -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/readFromTopButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Read from Top"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textSize="14sp"
                android:minHeight="40dp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/logo_dark_green"
                app:strokeWidth="2dp"
                android:textColor="@color/logo_dark_green"
                app:icon="@android:drawable/ic_menu_revert"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to the Butterfly Detector!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="24dp"
            android:gravity="center" />

        <!-- Erste Sektion -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tutorial_card_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/logo_green"
            android:padding="16dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:src="@drawable/ic_menu_camera"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="Camera icon" />

                <TextView
                    android:text="With the camera you can take pictures of butterflies. While the camera is open the button will automatically take pictures until you select the Photoselection. While you are anywhere else in the app, the button will take you back to the camera. To take pictures you will have to press the button again."
                    android:textSize="16sp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/black" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Zweite Sektion -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tutorial_card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/logo_green"
            android:padding="16dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:src="@drawable/ic_menu_photoselection"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="Photo selection icon" />

                <TextView
                    android:text="The photoselection will show you the taken pictures. Here you can choose the best picture to send it to AI identification. "
                    android:textSize="16sp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/black" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dritte Sektion -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tutorial_card_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/logo_green"
            android:padding="16dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:src="@drawable/ic_menu_transects"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="Transects icon" />

                <TextView
                    android:text="With the transects you can walk default routes and document any butterfly you can find."
                    android:textSize="16sp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/black" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Weiter-Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Los geht's!"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_gravity="center_horizontal"
            android:paddingHorizontal="32dp"
            android:paddingVertical="12dp"
            android:textSize="18sp"
            app:cornerRadius="24dp"
            android:backgroundTint="@color/purple_500"
            android:textColor="@color/white" />

    </LinearLayout>
</ScrollView>